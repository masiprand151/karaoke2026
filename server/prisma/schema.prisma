// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUM
//////////////////////////////////////////////////////

enum UserRole {
  admin
  staff
  cashier
}

enum TransactionStatus {
  pending
  paid
  cancel
}
enum RoomStatus {
  used
  maintenent
  standby
  offline
}

enum PaymentMethod {
  cash
  debit
  credit
  transfer
  qris
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id       Int      @id @default(autoincrement())
  username String   @unique
  password String
  role     UserRole

  sessions Session[]
}

//////////////////////////////////////////////////////
// ROOM
//////////////////////////////////////////////////////

model Room {
  id       Int    @id @default(autoincrement())
  name     String
  capacity Int
  status RoomStatus @default(standby)

  pricings Pricing[]
  sessions Session[]
}

//////////////////////////////////////////////////////
// PRICING
//////////////////////////////////////////////////////

model Pricing {
  id              Int       @id @default(autoincrement())

  roomId          Int
  room            Room      @relation(fields: [roomId], references: [id])

  name            String
  description     String?

  baseRate        Decimal   @db.Decimal(12,2)

  isHoliday       Boolean   @default(false)
  isPromo         Boolean   @default(false)
  durationMinutes Int @default(120)
  startDate       DateTime?
  endDate         DateTime?
  taxRate       Decimal @default(11.00) @db.Decimal(5,2) // %
  serviceCharge Decimal @default(5.00)  @db.Decimal(5,2) // %

  transactions    Transaction[]
  pricingFnbs     PricingFnb[]
  pricingLadies   PricingLady[]
}

//////////////////////////////////////////////////////
// SESSION
//////////////////////////////////////////////////////

model Session {
  id                Int       @id @default(autoincrement())

  userId            Int
  user              User      @relation(fields: [userId], references: [id])

  roomId            Int
  room              Room      @relation(fields: [roomId], references: [id])

  customerName      String

  start             DateTime
  end               DateTime
  closed Boolean @default(false)

  durationMinutes   Int
  extendMinutes     Int
  freeMinutes       Int

  createdAt DateTime @default(now())
  transaction       Transaction?

  sessionFnbs       SessionFnb[]
  sessionLadies     SessionLady[]
}

//////////////////////////////////////////////////////
// TRANSACTION
//////////////////////////////////////////////////////

model Transaction {
  id               Int                 @id @default(autoincrement())

  number           String              @unique

  sessionId        Int                 @unique
  session          Session             @relation(fields: [sessionId], references: [id])

  pricingId        Int
  pricing          Pricing             @relation(fields: [pricingId], references: [id])

  amount           Decimal             @db.Decimal(12,2)

  taxAmount        Decimal             @db.Decimal(12,2)

  serviceAmount    Decimal             @db.Decimal(12,2)

  grandTotal       Decimal             @db.Decimal(12,2)

  paymentMethod    PaymentMethod

  status           TransactionStatus

  createdAt        DateTime            @default(now())

  payments Payment[]
}

//////////////////////////////////////////////////////
// FNB
//////////////////////////////////////////////////////

model Fnb {
  id            Int        @id @default(autoincrement())

  name          String
  description   String?

  basePrice     Decimal    @db.Decimal(12,2)

  taxRate         Decimal   @db.Decimal(5,2)
  serviceCharge   Decimal   @db.Decimal(12,2)
  isPromo       Boolean    @default(false)
  stock Int @default(0)
  isStock Boolean @default(false)

  sessionFnbs   SessionFnb[]
  pricingFnbs   PricingFnb[]
}

//////////////////////////////////////////////////////
// SESSION FNB
//////////////////////////////////////////////////////

model SessionFnb {
  id            Int       @id @default(autoincrement())

  sessionId     Int
  session       Session   @relation(fields: [sessionId], references: [id])

  fnbId         Int
  fnb           Fnb       @relation(fields: [fnbId], references: [id])

  quantity      Int

  unitPrice     Decimal   @db.Decimal(12,2)

  totalAmount   Decimal   @db.Decimal(12,2)
}

//////////////////////////////////////////////////////
// PRICING FNB
//////////////////////////////////////////////////////

model PricingFnb {
  id             Int       @id @default(autoincrement())

  pricingId      Int
  pricing        Pricing   @relation(fields: [pricingId], references: [id])

  fnbId          Int
  fnb            Fnb       @relation(fields: [fnbId], references: [id])

  quantity       Int

  includeTax     Boolean   @default(false)
}

//////////////////////////////////////////////////////
// LADY
//////////////////////////////////////////////////////

model Lady {
  id              Int      @id @default(autoincrement())

  name            String

  description     String?

  basePrice       Decimal   @db.Decimal(12,2)

  isPromo         Boolean    @default(false)
  isJob Boolean @default(false)

  sessionLadies   SessionLady[]
  pricingLadies   PricingLady[]
}

//////////////////////////////////////////////////////
// SESSION LADY
//////////////////////////////////////////////////////

model SessionLady {
  id             Int       @id @default(autoincrement())

  sessionId      Int
  session        Session   @relation(fields: [sessionId], references: [id])

  ladyId         Int
  lady           Lady      @relation(fields: [ladyId], references: [id])

  quantity       Int
  
  start             DateTime
  end               DateTime

  unitPrice      Decimal   @db.Decimal(12,2)

  totalAmount    Decimal   @db.Decimal(12,2)
}

//////////////////////////////////////////////////////
// PRICING LADY
//////////////////////////////////////////////////////

model PricingLady {
  id            Int       @id @default(autoincrement())

  pricingId     Int
  pricing       Pricing   @relation(fields: [pricingId], references: [id])

  ladyId        Int
  lady          Lady      @relation(fields: [ladyId], references: [id])

  quantity      Int
}


model Payment {
  id            Int        @id @default(autoincrement())
  transactionId Int
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  method        PaymentMethod
  amount        Decimal     @db.Decimal(12,2)
  paidAt        DateTime    @default(now())
}
