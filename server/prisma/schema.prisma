// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUM
//////////////////////////////////////////////////////

enum UserRole {
  admin
  staff
  cashier
}

enum TransactionStatus {
  pending
  paid
  cancel
}

enum FnbCategory {
  food
  drink
  snack
  other
}

enum RoomStatus {
  used
  maintenent
  standby
  offline
}

enum PaymentMethod {
  cash
  debit
  credit
  transfer
  qris
}


enum LogType {
  lady
  fnb
  room
  discount
  action
  freeMinute
  payment
  checkout
  checkin
  duration
}

enum LogAction {
  update
  create
  delete
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id       Int      @id @default(autoincrement())
  username String   
  password String
  role     UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  sessions Session[]

  purchases Purchase[]
}

//////////////////////////////////////////////////////
// ROOM
//////////////////////////////////////////////////////

model Room {
  id       Int    @id @default(autoincrement())
  name     String
  capacity Int
  status RoomStatus @default(standby)

  pricings Pricing[]
  sessions Session[]
}

//////////////////////////////////////////////////////
// PRICING
//////////////////////////////////////////////////////

model Pricing {
  id              Int       @id @default(autoincrement())

  roomId          Int
  room            Room      @relation(fields: [roomId], references: [id])

  name            String
  description     String?

  baseRate        Decimal   @db.Decimal(12,2)

  isHoliday       Boolean   @default(false)
  isPromo         Boolean   @default(false)
  isPackage         Boolean   @default(false)
  durationMinutes Int @default(120)
  startDate       DateTime?
  endDate         DateTime?
  taxRate       Decimal @default(11.00) @db.Decimal(5,2) // %
  serviceCharge Decimal @default(5.00)  @db.Decimal(5,2) // %
  ladyQty Int @default(0)

  transactions    Transaction[]
  pricingFnbs     PricingFnb[]
  pricingLadies   PricingLady[]
}

//////////////////////////////////////////////////////
// SESSION
//////////////////////////////////////////////////////

model Session {
  id                Int       @id @default(autoincrement())

  userId            Int
  user              User      @relation(fields: [userId], references: [id])

  roomId            Int
  room              Room      @relation(fields: [roomId], references: [id])

  customerName      String

  start             DateTime
  end               DateTime
  closed Boolean @default(false)

  durationMinutes   Int
  extendMinutes     Int
  freeMinutes       Int

  createdAt DateTime @default(now())
  transaction       Transaction?

  sessionFnbs       SessionFnb[]
  sessionLadies     SessionLady[]

  sessionLogs SessionLog[]
}

//////////////////////////////////////////////////////
// TRANSACTION
//////////////////////////////////////////////////////

model Transaction {
  id               Int                 @id @default(autoincrement())

  number           String              @unique

  sessionId        Int                 @unique
  session          Session             @relation(fields: [sessionId], references: [id])

  pricingId        Int
  pricing          Pricing             @relation(fields: [pricingId], references: [id])
  roomDis  Decimal @default(0)  @db.Decimal(5,2) // %
  roomDisAmount Decimal @db.Decimal(12,2) @default(0)
  amount           Decimal             @db.Decimal(12,2)

  taxAmount        Decimal             @db.Decimal(12,2)

  serviceAmount    Decimal             @db.Decimal(12,2)

  grandTotal       Decimal             @db.Decimal(12,2)

  paymentMethod    PaymentMethod

  status           TransactionStatus

  createdAt        DateTime            @default(now())

  payments Payment[]
}

//////////////////////////////////////////////////////
// FNB
//////////////////////////////////////////////////////

model Fnb {
  id            Int        @id @default(autoincrement())

  name          String
  description   String?
  category FnbCategory @default(other)

  basePrice     Decimal    @db.Decimal(12,2)

  taxRate         Decimal   @db.Decimal(5,2)
  serviceCharge   Decimal   @db.Decimal(12,2)
  isPromo       Boolean    @default(false)
  stock Int @default(0)
  isStock Boolean @default(false)

  sessionFnbs   SessionFnb[]
  pricingFnbs   PricingFnb[]
  deletedAt DateTime?

  purchases Purchase[]
}

model Purchase {
  id            Int       @id @default(autoincrement())

  fnbId         Int
  fnb           Fnb       @relation(fields: [fnbId], references: [id])

  supplierName  String
  invoiceNumber String    // nomor nota dari supplier
  quantity      Int
  unitPrice     Decimal   @db.Decimal(12,2)
  totalAmount   Decimal   @db.Decimal(12,2)

  createdById   Int
  createdBy     User      @relation(fields: [createdById], references: [id])

  createdAt     DateTime  @default(now())
}


//////////////////////////////////////////////////////
// SESSION FNB
//////////////////////////////////////////////////////

model SessionFnb {
  id            Int       @id @default(autoincrement())

  sessionId     Int
  session       Session   @relation(fields: [sessionId], references: [id])

  fnbId         Int
  fnb           Fnb       @relation(fields: [fnbId], references: [id])

  quantity      Int

  unitPrice     Decimal   @db.Decimal(12,2)

  totalAmount   Decimal   @db.Decimal(12,2)
  
}

//////////////////////////////////////////////////////
// PRICING FNB
//////////////////////////////////////////////////////

model PricingFnb {
  id             Int       @id @default(autoincrement())

  pricingId      Int
  pricing        Pricing   @relation(fields: [pricingId], references: [id])

  fnbId          Int
  fnb            Fnb       @relation(fields: [fnbId], references: [id])

  quantity       Int

  includeTax     Boolean   @default(false)
}

//////////////////////////////////////////////////////
// LADY
//////////////////////////////////////////////////////

model Lady {
  id              Int      @id @default(autoincrement())

  name            String

  description     String?

  basePrice       Decimal   @db.Decimal(12,2)

  isPromo         Boolean    @default(false)
  isJob Boolean @default(false)

  sessionLadies   SessionLady[]
  pricingLadies   PricingLady[]
  deletedAt DateTime?
}

//////////////////////////////////////////////////////
// SESSION LADY
//////////////////////////////////////////////////////

model SessionLady {
  id             Int       @id @default(autoincrement())

  sessionId      Int
  session        Session   @relation(fields: [sessionId], references: [id])

  ladyId         Int
  lady           Lady      @relation(fields: [ladyId], references: [id])

  quantity       Int
  
  start             DateTime
  end               DateTime

  unitPrice      Decimal   @db.Decimal(12,2)

  totalAmount    Decimal   @db.Decimal(12,2)

}

//////////////////////////////////////////////////////
// PRICING LADY
//////////////////////////////////////////////////////

model PricingLady {
  id            Int       @id @default(autoincrement())

  pricingId     Int
  pricing       Pricing   @relation(fields: [pricingId], references: [id])

  ladyId        Int
  lady          Lady      @relation(fields: [ladyId], references: [id])

  quantity      Int
}


model Payment {
  id            Int        @id @default(autoincrement())
  transactionId Int
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  method        PaymentMethod
  amount        Decimal     @db.Decimal(12,2)
  paidAt        DateTime    @default(now())
}

model SessionLog {
  id            Int      @id @default(autoincrement())
  sessionId     Int
  transactionId Int?
  type          LogType   // "lady", "fnb", "room", "discount"
  targetId      Int?     // id dari sessionLady / sessionFnb / room
  action        LogAction   // "create", "update", "delete"
  oldValue      Json?  // simpan JSON string atau ringkas
  newValue      Json?  // simpan JSON string atau ringkas
  role          String   // admin / kasir / system
  userId        Int
  createdAt     DateTime @default(now())

  session       Session  @relation(fields: [sessionId], references: [id])
}



model Songs {
  id Int @id @default(autoincrement())
  name String
  filePath String @db.LongText
  size String
  artist String
  region String
  isActive Boolean @default(true)
}